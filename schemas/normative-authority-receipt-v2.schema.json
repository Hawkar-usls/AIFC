{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/normative-authority-receipt-v2.schema.json",
  "title": "AIFC Normative Authority Receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_id", "repository", "tested_source_commit", "tested_tree_sha", "unit_test_count", "workflow_runs", "artifacts", "checks", "platform_trust_proven", "status"],
  "properties": {
    "schema": {"const": "AIFC/normative-authority-receipt/v2"},
    "receipt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "repository": {"const": "Hawkar-usls/AIFC"},
    "tested_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tested_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "unit_test_count": {"type": "integer", "minimum": 1},
    "workflow_runs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "run_id", "workflow_name", "expected_conclusion"],
        "properties": {
          "role": {"type": "string", "minLength": 1, "maxLength": 64},
          "run_id": {"type": "integer", "minimum": 1},
          "workflow_name": {"type": "string", "minLength": 1, "maxLength": 256},
          "expected_conclusion": {"const": "success"}
        }
      }
    },
    "artifacts": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "name", "digest", "head_sha"],
        "properties": {
          "artifact_id": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    },
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["all_declared_workflows_success", "unit_test_count_recomputed", "ci_attestation_pass", "platform_receipt_pass", "lineage_activation_eligible"],
      "properties": {
        "all_declared_workflows_success": {"const": true},
        "unit_test_count_recomputed": {"const": true},
        "ci_attestation_pass": {"const": true},
        "platform_receipt_pass": {"const": true},
        "lineage_activation_eligible": {"const": true}
      }
    },
    "platform_trust_proven": {"const": false},
    "status": {"const": "EXACT_POST_MERGE_RECEIPT_CONFIRMED_REQUIRES_PROVENANCE_REPLAY"}
  }
}
