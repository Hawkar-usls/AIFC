{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/verifier-ci-attestation.schema.json",
  "title": "AIFC Verifier CI Attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "verifier_id",
    "verifier_version",
    "repository",
    "tested_source_commit_sha",
    "tested_tree_sha",
    "workflow",
    "bound_source_sets",
    "reports",
    "overall_status",
    "claim_ceiling",
    "generated_at"
  ],
  "properties": {
    "schema": {"const": "AIFC/verifier-ci-attestation/v1"},
    "verifier_id": {"const": "AIFC-Verifier-A"},
    "verifier_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "repository": {"const": "Hawkar-usls/AIFC"},
    "tested_source_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tested_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "raw_sha256",
        "run_id",
        "run_attempt",
        "job_id",
        "job_name",
        "event_name",
        "runner_os",
        "python_version"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 256},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "run_id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "run_attempt": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "job_id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "job_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "event_name": {"type": "string", "minLength": 1, "maxLength": 64},
        "runner_os": {"type": "string", "minLength": 1, "maxLength": 128},
        "python_version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "bound_source_sets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemas", "verifier_source", "test_corpus", "checkers"],
      "properties": {
        "schemas": {"$ref": "#/$defs/sourceSet"},
        "verifier_source": {"$ref": "#/$defs/sourceSet"},
        "test_corpus": {"$ref": "#/$defs/sourceSet"},
        "checkers": {"$ref": "#/$defs/sourceSet"}
      }
    },
    "reports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_conformance", "self_audit_conformance", "unittest"],
      "properties": {
        "base_conformance": {"$ref": "#/$defs/report"},
        "self_audit_conformance": {"$ref": "#/$defs/report"},
        "unittest": {"$ref": "#/$defs/unittestReport"}
      }
    },
    "overall_status": {"enum": ["PASS", "FAIL"]},
    "claim_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_a_pass", "aifc_v1_frozen", "physical_retrocausality"],
      "properties": {
        "implementation_a_pass": {"const": false},
        "aifc_v1_frozen": {"const": false},
        "physical_retrocausality": {"const": "NOT_OBSERVED"}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sourceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "file_count"],
      "properties": {
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "file_count": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "raw_sha256", "aifc_raw_evidence_hash", "exit_code"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 256},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "aifc_raw_evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "exit_code": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    },
    "unittestReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "raw_sha256", "aifc_raw_evidence_hash", "exit_code", "test_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 256},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "aifc_raw_evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
        "test_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    }
  },
  "description": "Out-of-tree CI evidence receipt. A PASS attestation is meaningful only for the exact source commit/tree and exact workflow/schema/verifier/checker/test/report hashes named here. It is not a frozen-release authorization and cannot establish Implementation A PASS by itself."
}
