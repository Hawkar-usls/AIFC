{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/validator-semantics-manifest.schema.json",
  "title": "AIFC Validator Semantics Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "semantics_id", "source_files", "runtime", "dependency_lock", "claim_boundary"],
  "properties": {
    "schema": {"const": "AIFC/validator-semantics-manifest/v1"},
    "semantics_id": {"type": "string", "minLength": 1, "maxLength": 192},
    "source_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "git_blob_sha1", "raw_sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 512},
          "git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation", "version", "json_schema_dialect", "validator_class", "format_checker",
        "schema_source_parser", "schema_source_encoding", "duplicate_key_policy", "schema_catalog_policy",
        "ref_resolution_policy", "protocol_schema_selector", "error_selection_policy", "number_model", "unicode_policy"
      ],
      "properties": {
        "implementation": {"type": "string"},
        "version": {"type": "string"},
        "json_schema_dialect": {"const": "https://json-schema.org/draft/2020-12/schema"},
        "validator_class": {"type": "string"},
        "format_checker": {"type": "string"},
        "schema_source_parser": {"type": "string"},
        "schema_source_encoding": {"type": "string"},
        "duplicate_key_policy": {"type": "string"},
        "schema_catalog_policy": {"type": "string"},
        "ref_resolution_policy": {"type": "string"},
        "protocol_schema_selector": {"type": "string"},
        "error_selection_policy": {"type": "string"},
        "number_model": {"type": "string"},
        "unicode_policy": {"type": "string"}
      }
    },
    "dependency_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "git_blob_sha1", "raw_sha256", "install_policy", "distributions"],
      "properties": {
        "path": {"type": "string"},
        "git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "install_policy": {"const": "ONLY_BINARY_REQUIRE_HASHES"},
        "distributions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "wheel_sha256"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "wheel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1, "maxLength": 4096}
  },
  "description": "Content-addressable manifest for the exact validator implementation, runtime policy and hash-locked dependency semantics that interpret registered issued schema bytes."
}
