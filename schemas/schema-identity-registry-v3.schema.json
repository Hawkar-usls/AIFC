{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/schema-identity-registry-v3.schema.json",
  "title": "AIFC Schema Identity Registry v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "registry_version",
    "predecessor_registry_path",
    "predecessor_registry_git_blob_sha1",
    "source_observed_at_commit",
    "records"
  ],
  "properties": {
    "schema": {"const": "AIFC/schema-identity-registry/v3"},
    "registry_version": {"const": 3},
    "predecessor_registry_path": {"const": "conformance/AIFC-SCHEMA-IDENTITY-REGISTRY-v2.json"},
    "predecessor_registry_git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_observed_at_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_id",
          "dialect",
          "source_path",
          "git_blob_sha1",
          "raw_schema_sha256",
          "first_registered_by_registry_version",
          "status"
        ],
        "properties": {
          "schema_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "dialect": {"const": "https://json-schema.org/draft/2020-12/schema"},
          "source_path": {"type": "string", "minLength": 1, "maxLength": 1024},
          "git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "raw_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "first_registered_by_registry_version": {"const": 3},
          "status": {"const": "REGISTERED_IMMUTABLE_SUCCESSOR_CANDIDATE"}
        }
      }
    }
  },
  "description": "Delta registry extending immutable schema-identity registry v2. Every newly issued SAL schema identity is bound to exact source bytes with both Git blob SHA-1 and raw SHA-256; v2 remains unchanged."
}
