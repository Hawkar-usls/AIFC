{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/trial-creation-policy.schema.json",
  "title": "AIFC Trial Creation Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_id",
    "experiment_id",
    "method",
    "slot_index_rule",
    "candidate_generation_before_created_forbidden",
    "silent_slot_deletion_forbidden",
    "frozen_before_first_created"
  ],
  "properties": {
    "schema": {"const": "AIFC/trial-creation-policy/v1"},
    "policy_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "method": {"enum": ["PREALLOCATED_SLOTS", "DETERMINISTIC_SCHEDULE", "EXTERNAL_TRIGGER_POLICY"]},
    "slot_index_rule": {"const": "CONTIGUOUS_ONE_BASED"},
    "declared_trial_count": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991},
    "schedule_or_trigger_spec_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "candidate_generation_before_created_forbidden": {"const": true},
    "silent_slot_deletion_forbidden": {"const": true},
    "frozen_before_first_created": {"const": true}
  }
}
