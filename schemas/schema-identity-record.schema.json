{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/schema-identity-record.schema.json",
  "title": "AIFC Issued Schema Identity Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_id",
    "dialect",
    "source_path",
    "source_content_algorithm",
    "source_content_id",
    "admission_semantics_version",
    "issued_at_source_commit",
    "status"
  ],
  "properties": {
    "schema": {"const": "AIFC/schema-identity-record/v1"},
    "schema_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "dialect": {"const": "https://json-schema.org/draft/2020-12/schema"},
    "source_path": {"type": "string", "pattern": "^schemas/[A-Za-z0-9._/-]+\\.json$"},
    "source_content_algorithm": {"enum": ["GIT_BLOB_SHA1", "SHA256"]},
    "source_content_id": {"type": "string", "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$"},
    "admission_semantics_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "issued_at_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"enum": ["ISSUED_IMMUTABLE", "HISTORICAL_DRAFT_ISSUED"]}
  },
  "allOf": [
    {
      "if": {"properties": {"source_content_algorithm": {"const": "GIT_BLOB_SHA1"}}, "required": ["source_content_algorithm"]},
      "then": {"properties": {"source_content_id": {"pattern": "^[0-9a-f]{40}$"}}},
      "else": {"properties": {"source_content_id": {"pattern": "^[0-9a-f]{64}$"}}}
    }
  ],
  "description": "Issued schema identifiers are immutable acceptance-language identities. Changing admitted instances requires a new schema identifier. The admission_semantics_version binds the validator semantics that interpret the exact schema source bytes."
}
