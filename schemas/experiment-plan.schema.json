{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/experiment-plan.schema.json",
  "title": "AIFC Experiment Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "experiment_id",
    "protocol_version",
    "mode",
    "trial_creation_policy_hash",
    "declared_trial_count",
    "initial_witness_registry_hash",
    "candidate_generation_policy_hash",
    "target_selector_policy_hash",
    "target_derivation_policy_hash",
    "entropy_policy_hash",
    "causal_model_hash",
    "statistical_plan_hash",
    "publication_policy_hash",
    "external_freshness_policy_hash",
    "conditioning_view_policy_hash",
    "allowed_registry_reconfiguration",
    "strongest_grade_exactly_one_target_derivation_per_trial",
    "frozen_before_first_created"
  ],
  "properties": {
    "schema": {"const": "AIFC/experiment-plan/v1"},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "protocol_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "mode": {"enum": ["FIXED_HORIZON", "ANYTIME_WITH_PREDICTABLE_POLICY"]},
    "trial_creation_policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "declared_trial_count": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991},
    "initial_witness_registry_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_generation_policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_selector_policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_derivation_policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entropy_policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_preimage_policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "causal_model_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "statistical_plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publication_policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "external_freshness_policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "conditioning_view_policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "allowed_registry_reconfiguration": {"type": "boolean"},
    "strongest_grade_exactly_one_target_derivation_per_trial": {"const": true},
    "frozen_before_first_created": {"const": true}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "FIXED_HORIZON"}}, "required": ["mode"]},
      "then": {"properties": {"declared_trial_count": {"type": "integer", "minimum": 1}}}
    }
  ],
  "description": "The pre-experiment contract. signature_preimage_policy_hash is the v0.5 strongest-grade binding that freezes the exact future Ed25519 message format before first CREATED. It remains optional at this draft schema layer only so historical v0.2/v0.3 fixtures remain readable; Verifier A v0.5 and the frozen release gate reject strongest-grade admission when it is absent. This compatibility allowance must be removed before v1.0 FROZEN."
}
