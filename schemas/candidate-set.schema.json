{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/candidate-set.schema.json",
  "title": "AIFC Frozen Candidate Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "experiment_id",
    "trial_index",
    "run_id",
    "hard_witness_hashes",
    "cardinality"
  ],
  "properties": {
    "schema": {"const": "AIFC/candidate-set/v1"},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "trial_index": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "hard_witness_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "uniqueItems": true
    },
    "cardinality": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
  },
  "description": "Verifier MUST require cardinality == len(hard_witness_hashes), every member hash to resolve to an AIFC/hard-witness/v1 object for the same experiment/trial/run, and strongest-grade multiplicity to account for the entire admitted set. Object identity is the external domain-separated canonical content hash."
}
