{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/assurance-monotonicity-record.schema.json",
  "title": "AIFC Assurance Monotonicity Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "predecessor_verifier",
    "successor_verifier",
    "fixture_hash",
    "wrapped_fixture_hash",
    "predecessor_outcome",
    "successor_outcome",
    "inherited_gate_set_hash",
    "monotonicity_result"
  ],
  "properties": {
    "schema": {"const": "AIFC/assurance-monotonicity-record/v1"},
    "predecessor_verifier": {"type": "string", "minLength": 1, "maxLength": 256},
    "successor_verifier": {"type": "string", "minLength": 1, "maxLength": 256},
    "fixture_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "wrapped_fixture_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "predecessor_outcome": {"type": "string", "minLength": 1, "maxLength": 128},
    "successor_outcome": {"type": "string", "minLength": 1, "maxLength": 128},
    "inherited_gate_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "monotonicity_result": {"enum": ["PASS", "FAIL"]},
    "failure_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z0-9_:.-]+$"}
    }
  },
  "description": "Proof-carrying record for predecessor/successor verifier outcome monotonicity on one frozen inherited-semantics fixture."
}
