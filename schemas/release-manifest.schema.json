{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/release-manifest.schema.json",
  "title": "AIFC Proof-Carrying Release Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release_id",
    "protocol_version",
    "source_commit",
    "release_gate_profile_hash",
    "gate_results",
    "delivery_mode",
    "overall_status"
  ],
  "properties": {
    "schema": {"const": "AIFC/release-manifest/v1"},
    "release_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "protocol_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "release_gate_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gate_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "result", "evidence_hash", "verifier_id", "verifier_version", "run_or_commit"],
        "properties": {
          "gate_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "result": {"enum": ["PASS", "FAIL", "BLOCKED", "UNRESOLVED"]},
          "evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "verifier_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "verifier_version": {"type": "string", "minLength": 1, "maxLength": 128},
          "run_or_commit": {"type": "string", "minLength": 1, "maxLength": 256},
          "notes_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "delivery_mode": {"const": "OUT_OF_TREE_RELEASE_ASSET_BOUND_TO_IMMUTABLE_SOURCE_COMMIT"},
    "release_record_binding_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "overall_status": {"enum": ["DRAFT_NOT_SATISFIED", "FROZEN_PASS", "REJECTED"]}
  },
  "description": "The final release manifest is generated after an immutable source_commit exists and is distributed as an out-of-tree release asset (for example a GitHub Release/Zenodo asset). Its external domain-separated content hash is then bound by the release record. It MUST NOT be required to live inside source_commit, avoiding a Git commit fixed-point. FROZEN_PASS requires evidence resolution for every gate; syntactic hashes are insufficient."
}
