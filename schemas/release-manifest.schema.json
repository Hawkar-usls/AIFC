{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/release-manifest.schema.json",
  "title": "AIFC Proof-Carrying Release Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release_id",
    "protocol_version",
    "repository_commit",
    "release_gate_profile_hash",
    "gate_results",
    "overall_status"
  ],
  "properties": {
    "schema": {"const": "AIFC/release-manifest/v1"},
    "release_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "protocol_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "release_gate_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gate_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "result", "evidence_hash", "verifier_id", "verifier_version", "run_or_commit"],
        "properties": {
          "gate_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "result": {"enum": ["PASS", "FAIL", "BLOCKED", "UNRESOLVED"]},
          "evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "verifier_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "verifier_version": {"type": "string", "minLength": 1, "maxLength": 128},
          "run_or_commit": {"type": "string", "minLength": 1, "maxLength": 256},
          "notes_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "overall_status": {"enum": ["DRAFT_NOT_SATISFIED", "FROZEN_PASS", "REJECTED"]}
  },
  "description": "The release manifest is identified by its external domain-separated canonical content hash. A self-hash field is intentionally forbidden. Verifier must enforce exact gate-set coverage, unique gate_id values, evidence resolution and all-PASS semantics for FROZEN_PASS."
}
