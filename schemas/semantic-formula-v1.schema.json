{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifc.dev/schemas/semantic-formula-v1.schema.json",
  "title": "AIFC Semantic Formula v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","formula_role","entailment_question_id","source_semantic_anchor_ids","semantic_compilation_profile_id","semantic_coverage_manifest_id","normalized_formula_ast","atom_bindings","formula_content_hash","derivation_status"],
  "properties": {
    "schema": {"const":"AIFC/semantic-formula/v1"},
    "formula_role": {"enum":["PREDECESSOR_PREMISE","TARGET_TRANSITION_PROFILE"]},
    "entailment_question_id": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_semantic_anchor_ids": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "semantic_compilation_profile_id": {"const":"AIFC-SEMANTIC-COMPILATION-PROFILE-V1"},
    "semantic_coverage_manifest_id": {"type":"string","minLength":1},
    "normalized_formula_ast": {"$ref":"#/$defs/formula"},
    "atom_bindings": {"type":"object","minProperties":1,"additionalProperties":{"type":"string","minLength":1}},
    "formula_content_hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "derivation_status": {"enum":["DETERMINISTIC_CANDIDATE_DERIVATION","AUTHORITY_ADMISSIBLE_DERIVATION"]}
  },
  "$defs": {
    "formula": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["op","id"],"properties":{"op":{"const":"ATOM"},"id":{"type":"string","minLength":1}}},
        {"type":"object","additionalProperties":false,"required":["op","arg"],"properties":{"op":{"const":"NOT"},"arg":{"$ref":"#/$defs/formula"}}},
        {"type":"object","additionalProperties":false,"required":["op","args"],"properties":{"op":{"enum":["AND","OR"]},"args":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/formula"}}}}
      ]
    }
  }
}
