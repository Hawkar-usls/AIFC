{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/target-derivation-profile.schema.json",
  "title": "AIFC Target Derivation Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile_id",
    "experiment_id",
    "trial_index",
    "run_id",
    "policy_hash",
    "source_id",
    "source_protocol_version",
    "raw_source_object_schema",
    "target_selector_profile_hash",
    "extraction",
    "transformation",
    "domain_separator",
    "output_length_bits",
    "frozen_before_target"
  ],
  "properties": {
    "schema": {"const": "AIFC/target-derivation-profile/v1"},
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "trial_index": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_protocol_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "raw_source_object_schema": {"type": "string", "minLength": 1, "maxLength": 512},
    "target_selector_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": {"enum": ["WHOLE_RAW_BYTES", "JSON_POINTER_UTF8_STRING", "JSON_POINTER_HEX_BYTES", "JSON_POINTER_BASE64_BYTES"]},
        "json_pointer": {"type": ["string", "null"], "maxLength": 1024}
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "framing", "input_order"],
      "properties": {
        "algorithm": {"enum": ["IDENTITY", "SHA-256"]},
        "framing": {"const": "AIFC_TYPED_LENGTH_PREFIXED_V1"},
        "input_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "EXTRACTED_BYTES",
              "SOURCE_ID_UTF8",
              "SOURCE_PROTOCOL_VERSION_UTF8",
              "TARGET_EVENT_ID_UTF8",
              "RUN_ID_UTF8",
              "PRE_RETURN_CERTIFICATE_HASH_BYTES"
            ]
          }
        }
      }
    },
    "domain_separator": {"type": "string", "pattern": "^[A-Za-z0-9:._-]+$", "minLength": 1, "maxLength": 128},
    "output_length_bits": {"type": "integer", "minimum": 1, "maximum": 65536},
    "frozen_before_target": {"const": true}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "extraction": {
            "properties": {"method": {"const": "WHOLE_RAW_BYTES"}},
            "required": ["method"]
          }
        }
      },
      "then": {
        "properties": {
          "extraction": {
            "properties": {"json_pointer": {"type": "null"}}
          }
        }
      },
      "else": {
        "properties": {
          "extraction": {
            "required": ["json_pointer"],
            "properties": {"json_pointer": {"type": "string"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transformation": {
            "properties": {"algorithm": {"const": "SHA-256"}},
            "required": ["algorithm"]
          }
        }
      },
      "then": {"properties": {"output_length_bits": {"const": 256}}}
    }
  ],
  "description": "The per-trial derivation program is bound to one concrete target-selector-profile. It is replayable at byte level; free-text extraction and OTHER algorithms are forbidden in strongest-grade v1."
}
