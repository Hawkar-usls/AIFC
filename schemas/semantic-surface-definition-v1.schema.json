{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/semantic-surface-definition-v1.schema.json",
  "title": "AIFC Semantic Surface Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "definition_id",
    "entailment_question_id",
    "surface_role",
    "source_artifact_id",
    "source_git_blob_sha1",
    "coverage_manifest_id",
    "required_normative_semantic_surface",
    "selection_rule",
    "selection_authority_status",
    "completeness_claim",
    "definition_content_hash"
  ],
  "properties": {
    "schema": {
      "const": "AIFC/semantic-surface-definition/v1"
    },
    "definition_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "entailment_question_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "surface_role": {
      "enum": [
        "PREDECESSOR",
        "TARGET"
      ]
    },
    "source_artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "source_git_blob_sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "coverage_manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "required_normative_semantic_surface": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selection_rule": {
      "const": "EXPLICIT_SUCCESSOR_CANDIDATE_SURFACE_V1"
    },
    "selection_authority_status": {
      "enum": [
        "SUCCESSOR_CANDIDATE_NOT_AUTHORITY_ADMISSIBLE",
        "PREDECESSOR_AUTHORITY_ADMITTED_SURFACE"
      ]
    },
    "completeness_claim": {
      "enum": [
        "NOT_ESTABLISHED",
        "AUTHORITY_ESTABLISHED_COMPLETE_FOR_QUESTION"
      ]
    },
    "definition_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "description": "Content-identified required semantic surface for one side of an issued entailment question. Identity does not imply authority or completeness."
}
