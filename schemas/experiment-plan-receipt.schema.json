{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/experiment-plan-receipt.schema.json",
  "title": "AIFC Experiment Plan Freeze Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "experiment_id", "logical_position", "content_hash", "registry_hash", "witness_id", "key_id", "signature_algorithm", "signature"],
  "properties": {
    "schema": {"const": "AIFC/experiment-plan-receipt/v1"},
    "signature_profile_id": {"const": "AIFC-ED25519-DIRECT-TYPED-V1"},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "logical_position": {"const": "EXPERIMENT_PLAN_FROZEN"},
    "content_schema": {"const": "AIFC/experiment-plan/v1"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_sequence": {"const": 0},
    "witness_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "signature_algorithm": {"const": "Ed25519"},
    "signature": {"type": "string", "minLength": 1, "maxLength": 1024},
    "wall_clock_timestamp": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"required": ["signature_profile_id"]},
      "then": {
        "required": ["content_schema", "registry_sequence", "wall_clock_timestamp"],
        "properties": {
          "signature": {"pattern": "^[0-9a-f]{128}$"}
        }
      }
    }
  ],
  "description": "Historical plan-freeze receipts remain readable without signature_profile_id for old development corpus. Strongest-grade v0.5 receipts declare the normative profile, bind content_schema=AIFC/experiment-plan/v1, registry_sequence=0 and an explicit timestamp/null, and use exactly 64 signature bytes encoded as lowercase hex."
}
