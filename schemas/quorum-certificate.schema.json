{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/quorum-certificate.schema.json",
  "title": "AIFC Quorum Certificate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "experiment_id", "trial_index", "logical_position", "content_hash", "registry_hash", "n", "f", "q", "receipts"],
  "properties": {
    "schema": {"const": "AIFC/quorum-certificate/v1"},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "trial_index": {"type": "integer", "minimum": 1},
    "logical_position": {"type": "string", "minLength": 1, "maxLength": 128},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "n": {"type": "integer", "minimum": 1},
    "f": {"type": "integer", "minimum": 0},
    "q": {"type": "integer", "minimum": 1},
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    }
  }
}
