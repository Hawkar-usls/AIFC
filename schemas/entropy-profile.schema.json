{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/entropy-profile.schema.json",
  "title": "AIFC Entropy Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile_id",
    "source_id",
    "source_protocol_version",
    "target_selector",
    "target_derivation_profile_hash",
    "conditioning_view_hash",
    "point_probability_upper_bound",
    "derivation_method",
    "assumptions",
    "unresolved_assumptions",
    "external_evidence",
    "admission_status"
  ],
  "properties": {
    "schema": {"const": "AIFC/entropy-profile/v1"},
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_protocol_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "selector_hash"],
      "properties": {
        "method": {"type": "string", "minLength": 1, "maxLength": 256},
        "selector_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_round_or_event": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "target_derivation_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "conditioning_view_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "point_probability_upper_bound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator_dec", "denominator_dec", "canonical_reduced"],
      "properties": {
        "numerator_dec": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
        "denominator_dec": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "canonical_reduced": {"const": true}
      },
      "description": "Verifier MUST parse exact integers, require 0 <= numerator <= denominator, gcd(numerator,denominator)=1, denominator>0, and use only the unique reduced decimal representation without leading zeroes. 0 MUST be 0/1 and 1 MUST be 1/1."
    },
    "min_entropy_bits_lower_bound": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "derivation_method": {
      "enum": [
        "CERTIFIED_UNIFORM_BITS",
        "PUBLIC_BEACON_SPECIFICATION",
        "EXTERNAL_SECURITY_PROOF",
        "CONSERVATIVE_ANALYTIC_BOUND",
        "EMPIRICAL_MODEL_WITH_DECLARED_ASSUMPTIONS",
        "OTHER_DOCUMENTED_METHOD"
      ]
    },
    "derivation_document_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "unresolved_assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "external_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_type", "content_hash"],
        "properties": {
          "evidence_type": {"type": "string", "minLength": 1, "maxLength": 128},
          "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "locator": {"type": ["string", "null"], "maxLength": 2048}
        }
      }
    },
    "admission_status": {"enum": ["ADMITTED", "BLOCKED_UNRESOLVED_ASSUMPTIONS", "BLOCKED_MISSING_EVIDENCE", "BLOCKED_INVALID_BOUND"]}
  }
}
