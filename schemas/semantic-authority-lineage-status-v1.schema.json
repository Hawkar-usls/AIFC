{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/semantic-authority-lineage-status-v1.schema.json",
  "title": "AIFC Semantic Authority Lineage Status v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status_id",
    "entailment_question_id",
    "subject_records",
    "self_asserted_authority_forbidden",
    "lineage_status",
    "status_content_hash"
  ],
  "properties": {
    "schema": {
      "const": "AIFC/semantic-authority-lineage-status/v1"
    },
    "status_id": {
      "const": "AIFC-SAL-V1.10-SEMANTIC-AUTHORITY-LINEAGE-STATUS-V1"
    },
    "entailment_question_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject_id",
          "subject_kind",
          "authority_claim_field",
          "observed_status",
          "lineage_receipt_id"
        ],
        "properties": {
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "subject_kind": {
            "enum": [
              "SEMANTIC_SURFACE",
              "BRIDGE_THEORY",
              "BRIDGE_AXIOM",
              "BRIDGE_EXECUTION_PROFILE",
              "ENTAILMENT_METHOD_PROFILE",
              "QUESTION_SOURCE_BINDING",
              "ENDPOINT_BINDING_PROFILE",
              "CAPACITY_EXTENSION"
            ]
          },
          "authority_claim_field": {
            "type": "string",
            "minLength": 1
          },
          "observed_status": {
            "type": "string",
            "minLength": 1
          },
          "lineage_receipt_id": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          }
        }
      }
    },
    "self_asserted_authority_forbidden": {
      "const": true
    },
    "lineage_status": {
      "enum": [
        "NOT_ESTABLISHED_REQUIRES_ROOT_CLOSED_TRANSITION",
        "AUTHORITY_LINEAGE_ESTABLISHED"
      ]
    },
    "status_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
