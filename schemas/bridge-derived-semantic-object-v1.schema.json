{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/Hawkar-usls/AIFC/schemas/bridge-derived-semantic-object-v1.schema.json","title":"AIFC Bridge-Derived Semantic Object v1","type":"object","additionalProperties":false,"required":["schema","derived_semantic_object_id","entailment_question_id","atom_id","semantic_identity","derivation_kind","source_semantic_identities","derivation_authority_status","authority_lineage_ref","derivation_content_hash"],"properties":{"schema":{"const":"AIFC/bridge-derived-semantic-object/v1"},"derived_semantic_object_id":{"type":"string","minLength":1},"entailment_question_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"atom_id":{"type":"string","minLength":1},"semantic_identity":{"type":"string","minLength":1},"derivation_kind":{"const":"BRIDGE_DERIVED_SEMANTIC_OBJECT_V1"},"source_semantic_identities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"derivation_authority_status":{"enum":["SUCCESSOR_CANDIDATE_NOT_AUTHORITY_ADMISSIBLE","AUTHORITY_ADMISSIBLE"]},"authority_lineage_ref":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["transition_id","receipt_id","authority_registry_id"],"properties":{"transition_id":{"type":"string","minLength":1},"receipt_id":{"type":"string","minLength":1},"authority_registry_id":{"type":"string","minLength":1}}}]},"derivation_content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"allOf":[{"if":{"properties":{"derivation_authority_status":{"const":"AUTHORITY_ADMISSIBLE"}},"required":["derivation_authority_status"]},"then":{"properties":{"authority_lineage_ref":{"type":"object"}}},"else":{"properties":{"authority_lineage_ref":{"type":"null"}}}}],"description":"Content-identified semantic object required for every BRIDGE_DERIVED_ATOM. Authority-admissible derived semantics require a separate authority-lineage reference."}
