{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/schema-identity-record-v2.schema.json",
  "title": "AIFC Issued Schema Identity Record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_id",
    "dialect",
    "source_path",
    "git_blob_sha1",
    "raw_schema_sha256",
    "admission_semantics_id",
    "admission_semantics_content_hash",
    "source_bytes_observed_at_commit",
    "registered_immutable_at_commit",
    "first_historical_appearance_status",
    "status"
  ],
  "properties": {
    "schema": {"const": "AIFC/schema-identity-record/v2"},
    "schema_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "dialect": {"const": "https://json-schema.org/draft/2020-12/schema"},
    "source_path": {"type": "string", "pattern": "^schemas/[A-Za-z0-9._/-]+\\.json$"},
    "git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "raw_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "admission_semantics_id": {"type": "string", "minLength": 1, "maxLength": 192},
    "admission_semantics_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_bytes_observed_at_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "registered_immutable_at_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "first_historical_appearance_status": {"enum": ["NOT_ESTABLISHED", "SEPARATELY_PROVEN"]},
    "first_historical_appearance_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "status": {"enum": ["REGISTERED_IMMUTABLE_CURRENT", "HISTORICAL_PRE_CONVERGENCE_ONLY"]}
  },
  "description": "Dual-content-identity record. Git blob SHA-1 is the repository provenance locator; raw SHA-256 is the protocol cryptographic identity. registered_immutable_at_commit means the convergence/registration point at which this exact acceptance-language identity became protected; it is not implicitly the schema ID's first historical appearance."
}
