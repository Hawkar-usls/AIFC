{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/assurance-monotonicity-record-v3.schema.json",
  "title": "AIFC Assurance Monotonicity Record v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "predecessor_verifier",
    "successor_verifier",
    "fixture_hash",
    "wrapped_fixture_hash",
    "normative_root_registry_id",
    "bootstrap_root_commit",
    "predecessor_release_gate_id",
    "predecessor_release_gate_git_blob_sha1",
    "successor_release_gate_id",
    "successor_release_gate_git_blob_sha1",
    "predecessor_outcome",
    "successor_outcome",
    "admission_order_id",
    "admission_order_git_blob_sha1",
    "inherited_gate_hash_profile_id",
    "inherited_gate_set_hash",
    "gate_replacement_authority_status",
    "monotonicity_result"
  ],
  "properties": {
    "schema": {"const": "AIFC/assurance-monotonicity-record/v3"},
    "predecessor_verifier": {"type": "string", "minLength": 1, "maxLength": 256},
    "successor_verifier": {"type": "string", "minLength": 1, "maxLength": 256},
    "fixture_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "wrapped_fixture_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "normative_root_registry_id": {"const": "AIFC-NORMATIVE-ASSURANCE-ROOTS-V1"},
    "bootstrap_root_commit": {"const": "908de7afddcf9f72c98c2b3fb696a41be1e438e0"},
    "predecessor_release_gate_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "predecessor_release_gate_git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "successor_release_gate_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "successor_release_gate_git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "predecessor_outcome": {"type": "string", "minLength": 1, "maxLength": 128},
    "successor_outcome": {"type": "string", "minLength": 1, "maxLength": 128},
    "admission_order_id": {"const": "AIFC-ADMISSION-AUTHORITY-PARTIAL-ORDER-V1"},
    "admission_order_git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "inherited_gate_hash_profile_id": {"const": "AIFC-INHERITED-GATE-OBLIGATION-HASH-V1"},
    "inherited_gate_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gate_replacement_authority_status": {
      "enum": [
        "NOT_REQUIRED_ADDITIVE_ONLY",
        "BLOCKED_UNTIL_GATE_DEFINITION_AND_ATOM_ANCHORING",
        "AUTHORITY_CLOSED_PROOF_CONFIRMED"
      ]
    },
    "monotonicity_result": {"enum": ["PASS", "FAIL"]},
    "failure_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z0-9_:;=.,-]+$"}
    }
  },
  "description": "Proof-anchored successor record. v3 identifies release gates and admission order through a bootstrap-rooted normative registry, uses a dedicated inherited-obligation hash profile, and explicitly blocks gate replacement until theorem semantics are authoritatively anchored."
}
