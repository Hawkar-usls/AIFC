{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/normative-assurance-root-registry-v2.schema.json",
  "title": "AIFC Normative Assurance Root Registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "registry_id",
    "predecessor_registry_id",
    "predecessor_registry_git_blob_sha1",
    "predecessor_exact_main_commit",
    "records"
  ],
  "properties": {
    "schema": {"const": "AIFC/normative-assurance-root-registry/v2"},
    "registry_id": {"const": "AIFC-NORMATIVE-ASSURANCE-ROOTS-V2"},
    "predecessor_registry_id": {"const": "AIFC-NORMATIVE-ASSURANCE-ROOTS-V1"},
    "predecessor_registry_git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "predecessor_exact_main_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "kind",
          "expected_schema",
          "relative_path",
          "git_blob_sha1",
          "authority_status",
          "authority_commit",
          "authority_receipt_id"
        ],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "kind": {
            "enum": [
              "RELEASE_GATE",
              "ADMISSION_ORDER",
              "ASSURANCE_HASH_PROFILE",
              "INHERITED_GATE_HASH_PROFILE",
              "SCHEMA_IDENTITY_REGISTRY",
              "HASH_IMPLEMENTATION_BINDING",
              "OTHER_NORMATIVE_OBJECT"
            ]
          },
          "expected_schema": {"type": "string", "minLength": 1, "maxLength": 256},
          "relative_path": {"type": "string", "minLength": 1, "maxLength": 1024},
          "git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "authority_status": {
            "enum": [
              "HISTORICAL_ROOT_AT_PREDECESSOR_COMMIT",
              "ATTESTED_SUCCESSOR_AT_COMMIT",
              "SUCCESSOR_CANDIDATE_REQUIRES_EXACT_COMMIT_ATTESTATION"
            ]
          },
          "authority_commit": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            ]
          },
          "authority_receipt_id": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "minLength": 1, "maxLength": 256}
            ]
          }
        }
      }
    }
  },
  "description": "Root-closure successor registry. The registry has an explicit predecessor content identity, and record authority_status is executable rather than descriptive: historical roots bind to the predecessor commit, attested successors require an exact authority receipt, and unattested candidates fail closed."
}
