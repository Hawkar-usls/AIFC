    "target_profile_id": {"const":"AIFC-LINEAGE-TRANSITION-PROFILE-V1"},
    "target_profile_git_blob_sha1": {"const":"f096dbbb6d6382f58b3f2bbd3b7ad170b46d5e1b"},
    "entailment_method": {"const":"ANCHOR_GATED_FINITE_PROPOSITIONAL_IMPLICATION_V1"},
