{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/schema-identity-registry.schema.json",
  "title": "AIFC Issued Schema Identity Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registry_version", "validation_semantics_id", "records"],
  "properties": {
    "schema": {"const": "AIFC/schema-identity-registry/v1"},
    "registry_version": {"type": "integer", "const": 1},
    "validation_semantics_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "schema-identity-record.schema.json"}
    }
  },
  "description": "Registry of schema identifiers whose exact acceptance-language identities have been issued and therefore may not be silently mutated. v1.0 FROZEN requires coverage of the complete normative schema graph."
}
