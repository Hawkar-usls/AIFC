{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/assurance-monotonicity-record-v4.schema.json",
  "title": "AIFC Assurance Monotonicity Record v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "predecessor_verifier",
    "successor_verifier",
    "normative_root_registry_id",
    "normative_root_registry_git_blob_sha1",
    "predecessor_normative_root_registry_id",
    "predecessor_normative_root_registry_git_blob_sha1",
    "predecessor_exact_main_commit",
    "predecessor_release_gate_id",
    "predecessor_release_gate_git_blob_sha1",
    "successor_release_gate_id",
    "successor_release_gate_git_blob_sha1",
    "admission_order_id",
    "admission_order_git_blob_sha1",
    "inherited_gate_hash_profile_id",
    "inherited_gate_set_hash",
    "authority_status_enforced",
    "resolver_provenance_closed",
    "monotonicity_result",
    "failure_codes"
  ],
  "properties": {
    "schema": {"const": "AIFC/assurance-monotonicity-record/v4"},
    "predecessor_verifier": {"type": "string", "minLength": 1, "maxLength": 256},
    "successor_verifier": {"type": "string", "minLength": 1, "maxLength": 256},
    "normative_root_registry_id": {"const": "AIFC-NORMATIVE-ASSURANCE-ROOTS-V2"},
    "normative_root_registry_git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "predecessor_normative_root_registry_id": {"const": "AIFC-NORMATIVE-ASSURANCE-ROOTS-V1"},
    "predecessor_normative_root_registry_git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "predecessor_exact_main_commit": {"const": "7e58b47398fe585b24db6304ee6122871095d668"},
    "predecessor_release_gate_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "predecessor_release_gate_git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "successor_release_gate_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "successor_release_gate_git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "admission_order_id": {"const": "AIFC-ADMISSION-AUTHORITY-PARTIAL-ORDER-V1"},
    "admission_order_git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "inherited_gate_hash_profile_id": {"const": "AIFC-INHERITED-GATE-OBLIGATION-HASH-V1"},
    "inherited_gate_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_status_enforced": {"const": true},
    "resolver_provenance_closed": {"const": true},
    "monotonicity_result": {"enum": ["PASS", "FAIL"]},
    "failure_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z0-9_:;=.,-]+$"}
    }
  },
  "description": "Root-closed successor record. v4 binds the normative root registry by content identity and records that resolver provenance and authority-status admission were executed, while preserving v3 as historical evidence."
}
