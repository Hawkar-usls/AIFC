{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/Hawkar-usls/AIFC/schemas/semantic-derivation-profile-v1.schema.json","title":"AIFC Semantic Derivation Profile v1","type":"object","additionalProperties":false,"required":["schema","derivation_profile_id","entailment_question_id","logical_fragment","derivation_rule_semantics","normalization_semantics","leaf_extraction_semantics","context_projection_semantics","output_semantics","ambiguity_policy","unsupported_construct_policy","resolver_profile_id","resolver_profile_content_hash","execution_implementation_path","execution_implementation_git_blob_sha1","execution_implementation_raw_sha256","profile_authority_status","profile_content_hash"],"properties":{"schema":{"const":"AIFC/semantic-derivation-profile/v1"},"derivation_profile_id":{"type":"string","minLength":1},"entailment_question_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"logical_fragment":{"type":"string","minLength":1},"derivation_rule_semantics":{"type":"string","minLength":1},"normalization_semantics":{"type":"string","minLength":1},"leaf_extraction_semantics":{"type":"string","minLength":1},"context_projection_semantics":{"type":"string","minLength":1},"output_semantics":{"type":"string","minLength":1},"ambiguity_policy":{"type":"string","minLength":1},"unsupported_construct_policy":{"type":"string","minLength":1},"resolver_profile_id":{"type":"string","minLength":1},"resolver_profile_content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"execution_implementation_path":{"type":"string","minLength":1},"execution_implementation_git_blob_sha1":{"type":"string","pattern":"^[0-9a-f]{40}$"},"execution_implementation_raw_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"profile_authority_status":{"enum":["SUCCESSOR_CANDIDATE_NOT_AUTHORITY_ADMISSIBLE","ROOT_CLOSED_AUTHORITY_ADMISSIBLE"]},"profile_content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
