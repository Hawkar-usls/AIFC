{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/experiment-plan-quorum.schema.json",
  "title": "AIFC Experiment Plan Freeze Quorum v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "experiment_id",
    "logical_position",
    "content_hash",
    "registry_hash",
    "n",
    "f",
    "q",
    "receipts"
  ],
  "properties": {
    "schema": {"const": "AIFC/experiment-plan-quorum/v1"},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "logical_position": {"const": "EXPERIMENT_PLAN_FROZEN"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "n": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "f": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "q": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "experiment-plan-receipt.schema.json"}
    }
  },
  "description": "Experiment-scoped quorum certifying the exact experiment-plan content hash before any CREATED slot. Verifier must match n/f/q to the initial witness registry, enforce 2q>n+f, count q distinct active witness identities in q distinct failure domains, and cryptographically verify every receipt before frozen admission."
}
