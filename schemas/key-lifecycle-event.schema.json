{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/key-lifecycle-event.schema.json",
  "title": "AIFC Historical Key Lifecycle Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "experiment_id",
    "event_index",
    "previous_event_hash",
    "event_type",
    "witness_id",
    "key_id",
    "subject_registry_hash",
    "recorded_against_registry_hash",
    "recorded_against_registry_sequence",
    "effective_from_registry_sequence",
    "boundary_basis",
    "evidence_hashes",
    "reason_code",
    "wall_clock_timestamp"
  ],
  "properties": {
    "schema": {"const": "AIFC/key-lifecycle-event/v1"},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "event_index": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "previous_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_type": {"enum": ["COMPROMISE_DISCOVERED", "REVOCATION_DECLARED", "RETIREMENT_DECLARED"]},
    "witness_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "subject_registry_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recorded_against_registry_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recorded_against_registry_sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "effective_from_registry_sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "boundary_basis": {
      "enum": [
        "EXACT_KNOWN",
        "CONSERVATIVE_LOWER_BOUND",
        "UNKNOWN_FROM_GENESIS",
        "PROSPECTIVE_DECLARATION"
      ]
    },
    "evidence_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 256},
    "wall_clock_timestamp": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"event_type": {"const": "COMPROMISE_DISCOVERED"}}, "required": ["event_type"]},
      "then": {
        "properties": {
          "boundary_basis": {"enum": ["EXACT_KNOWN", "CONSERVATIVE_LOWER_BOUND", "UNKNOWN_FROM_GENESIS"]}
        }
      },
      "else": {
        "properties": {
          "boundary_basis": {"const": "PROSPECTIVE_DECLARATION"}
        }
      }
    }
  ],
  "description": "Hash-chained lifecycle event. COMPROMISE_DISCOVERED may retroactively invalidate signatures using effective_from_registry_sequence; UNKNOWN_FROM_GENESIS must be interpreted as sequence zero. REVOCATION_DECLARED and RETIREMENT_DECLARED are prospective declarations. The verifier resolves subject/recording registries and every evidence hash. Wall-clock time is metadata only. Local event presence does not prove the lifecycle history is complete or fresh."
}
