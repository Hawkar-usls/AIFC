{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/execution-environment-manifest.schema.json",
  "title": "AIFC Execution Environment Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "platform",
    "repository",
    "tested_source_commit_sha",
    "runner",
    "python",
    "installer",
    "dependency_lock",
    "installed_distributions",
    "actions",
    "generated_at"
  ],
  "properties": {
    "schema": {"const": "AIFC/execution-environment-manifest/v1"},
    "platform": {"const": "GITHUB_ACTIONS"},
    "repository": {"const": "Hawkar-usls/AIFC"},
    "tested_source_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "image_os", "image_version", "os_release_raw_sha256"],
      "properties": {
        "os": {"type": "string", "minLength": 1, "maxLength": 128},
        "arch": {"type": "string", "minLength": 1, "maxLength": 128},
        "image_os": {"type": "string", "minLength": 1, "maxLength": 128},
        "image_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "os_release_raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version"],
      "properties": {
        "implementation": {"const": "CPython"},
        "version": {"type": "string", "pattern": "^3\\.12\\.[0-9]+$"}
      }
    },
    "installer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pip_version"],
      "properties": {
        "pip_version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "dependency_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "raw_sha256", "require_hashes", "only_binary"],
      "properties": {
        "path": {"const": "reference/verifier/requirements.lock.txt"},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "require_hashes": {"const": true},
        "only_binary": {"const": true}
      }
    },
    "installed_distributions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "maxLength": 128},
          "version": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "commit_sha"],
        "properties": {
          "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "maxLength": 128},
          "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "description": "Observed verifier execution environment. Binding this manifest makes two runs on the same source tree distinguishable when runner image, Python, action commits, dependency lock, or installed distribution versions differ. It does not by itself prove the runner platform trustworthy."
}
