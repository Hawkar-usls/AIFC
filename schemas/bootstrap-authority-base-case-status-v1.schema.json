{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/bootstrap-authority-base-case-status-v1.schema.json",
  "title": "AIFC Bootstrap Authority Base Case Status v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status_id",
    "designation_source_registry_id",
    "designation_source_registry_git_blob_sha1",
    "designated_bootstrap_commit",
    "designated_historical_objects",
    "authority_basis_status",
    "retroactive_discovery_of_preexisting_authority",
    "external_bootstrap_ratification_status",
    "normative_authority_claim"
  ],
  "properties": {
    "schema": {"const": "AIFC/bootstrap-authority-base-case-status/v1"},
    "status_id": {"const": "AIFC-SAL-BOOTSTRAP-AUTHORITY-BASE-CASE-STATUS-V1"},
    "designation_source_registry_id": {"const": "AIFC-NORMATIVE-ASSURANCE-ROOTS-V1"},
    "designation_source_registry_git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "designated_bootstrap_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "designated_historical_objects": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "relative_path", "git_blob_sha1"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1},
          "git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    },
    "authority_basis_status": {"enum": ["IMPLICIT_NOT_YET_FIRST_CLASS", "EXTERNAL_BOOTSTRAP_RATIFIED"]},
    "retroactive_discovery_of_preexisting_authority": {"const": false},
    "external_bootstrap_ratification_status": {"enum": ["NOT_PERFORMED", "PERFORMED_EXPLICITLY"]},
    "normative_authority_claim": {"enum": ["NOT_ESTABLISHED_BY_THIS_OBJECT", "EXPLICIT_EXTERNAL_BASE_CASE"]}
  },
  "description": "Records the already-existing bootstrap designation without pretending that Git identity, CI, or this successor-created status object manufactures normative jurisdiction."
}
