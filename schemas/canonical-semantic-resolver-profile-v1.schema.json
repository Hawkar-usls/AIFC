{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/Hawkar-usls/AIFC/schemas/canonical-semantic-resolver-profile-v1.schema.json","title":"AIFC Canonical Semantic Resolver Profile v1","type":"object","additionalProperties":false,"required":["schema","resolver_profile_id","entailment_question_id","source_object_schema_id","locator_semantics","canonical_identity_semantics","role_classification_semantics","authority_scope_semantics","ambiguity_policy","unsupported_construct_policy","implementation_path","implementation_git_blob_sha1","implementation_raw_sha256","profile_authority_status","profile_content_hash"],"properties":{"schema":{"const":"AIFC/canonical-semantic-resolver-profile/v1"},"resolver_profile_id":{"type":"string","minLength":1},"entailment_question_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"source_object_schema_id":{"type":"string","minLength":1},"locator_semantics":{"type":"string","minLength":1},"canonical_identity_semantics":{"type":"string","minLength":1},"role_classification_semantics":{"type":"string","minLength":1},"authority_scope_semantics":{"type":"string","minLength":1},"ambiguity_policy":{"const":"AMBIGUITY_BLOCKS_NO_TIE_BREAK"},"unsupported_construct_policy":{"const":"UNRESOLVED"},"implementation_path":{"type":"string","minLength":1},"implementation_git_blob_sha1":{"type":"string","pattern":"^[0-9a-f]{40}$"},"implementation_raw_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"profile_authority_status":{"enum":["SUCCESSOR_CANDIDATE_NOT_AUTHORITY_ADMISSIBLE","ROOT_CLOSED_AUTHORITY_ADMISSIBLE"]},"profile_content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
