{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/gate-definition.schema.json",
  "title": "AIFC Machine Gate Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "gate_id", "definition_version", "pass_condition"],
  "properties": {
    "schema": {"const": "AIFC/gate-definition/v1"},
    "gate_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
    "definition_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "pass_condition": {"$ref": "#/$defs/expr"},
    "description": {"type": "string", "maxLength": 4096}
  },
  "$defs": {
    "expr": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id"],
          "properties": {
            "op": {"const": "ATOM"},
            "id": {"type": "string", "pattern": "^[A-Z0-9_.:-]+$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "value"],
          "properties": {
            "op": {"const": "CONST"},
            "value": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "args"],
          "properties": {
            "op": {"enum": ["AND", "OR"]},
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {"$ref": "#/$defs/expr"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "arg"],
          "properties": {
            "op": {"const": "NOT"},
            "arg": {"$ref": "#/$defs/expr"}
          }
        }
      ]
    }
  },
  "description": "Restricted declarative pass-condition language used when a mandatory gate is replaced. It intentionally supports only machine-exhaustible Boolean definitions; unrepresentable gates remain non-removable until a stronger proof method is introduced under a new versioned evidence profile."
}
