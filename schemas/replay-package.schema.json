{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/replay-package.schema.json",
  "title": "AIFC Verifier A Replay Package v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "experiment_id",
    "subject_trial_index",
    "experiment_plan_hash",
    "ledger_event_hashes",
    "evidence_bundle_hash",
    "hard_witness_hashes",
    "candidate_set_hash",
    "candidate_generation_profile_hash",
    "pre_return_certificate_hash",
    "created_quorum_certificate_hash",
    "pre_return_quorum_certificate_hash",
    "target_selector_profile_hash",
    "target_derivation_profile_hash",
    "pre_target_conditioning_view_hash",
    "entropy_profile_hash",
    "causal_model_hash",
    "statistical_plan_hash",
    "witness_registry_hash",
    "registry_transition_certificate_hashes",
    "target_evidence_hash",
    "publication_manifest_hash"
  ],
  "properties": {
    "schema": {"const": "AIFC/replay-package/v0.2"},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "subject_trial_index": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "experiment_plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ledger_event_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "evidence_bundle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hard_witness_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "uniqueItems": true
    },
    "candidate_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_generation_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pre_return_certificate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_quorum_certificate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pre_return_quorum_certificate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_selector_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_derivation_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pre_target_conditioning_view_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entropy_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "causal_model_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "statistical_plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "eprocess_state_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "witness_registry_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_transition_certificate_hashes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "uniqueItems": true
    },
    "target_evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publication_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "description": "Development manifest for standalone Verifier A replay. It contains only content identities. Every referenced object must be resolved from exact bytes through AIFC/evidence-store-index/v1 and independently rehashed before use. It is not itself a frozen AIFC v1 evidence object and does not establish Implementation A PASS."
}
