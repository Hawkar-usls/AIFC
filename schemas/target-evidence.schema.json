{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/target-evidence.schema.json",
  "title": "AIFC Target Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "experiment_id",
    "trial_index",
    "source_id",
    "target_selector_hash",
    "target_derivation_profile_hash",
    "target_event_id",
    "raw_source_object_hash",
    "target_canonical_hash",
    "entropy_profile_hash",
    "source_evidence_hashes"
  ],
  "properties": {
    "schema": {"const": "AIFC/target-evidence/v1"},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "trial_index": {"type": "integer", "minimum": 1},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "target_selector_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_derivation_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_event_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "raw_source_object_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_canonical_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_bytes_hex": {"type": ["string", "null"], "pattern": "^(|[0-9a-f]{2}([0-9a-f]{2})*)$"},
    "entropy_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_evidence_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "uniqueItems": true
    },
    "wall_clock_timestamp": {"type": ["string", "null"], "format": "date-time"}
  }
}
