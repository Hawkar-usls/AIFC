{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/verifier-result.schema.json",
  "title": "AIFC Verifier Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "experiment_id", "trial_index", "verifier_id", "verifier_version", "evidence_bundle_hash", "gate_results", "exact_match", "terminal_grade", "physical_interpretation"],
  "properties": {
    "schema": {"const": "AIFC/verifier-result/v1"},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "trial_index": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "verifier_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "verifier_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "evidence_bundle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gate_results": {
      "type": "object",
      "additionalProperties": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE"]}
    },
    "exact_match": {"type": "boolean"},
    "terminal_grade": {
      "enum": [
        "NOT_ADMITTED",
        "STRUCTURAL_MATCH_ONLY",
        "FORWARD_NULL_CONSISTENT_MISS",
        "FORWARD_NULL_INCOMPATIBILITY_CANDIDATE",
        "INVALIDATED_EVIDENCE"
      ]
    },
    "failure_codes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 2048},
      "uniqueItems": true
    },
    "crypto_backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend_id", "version_line", "executable_sha256"],
      "properties": {
        "backend_id": {"const": "OPENSSL_PKEYUTL_ED25519_V1"},
        "version_line": {"type": "string", "minLength": 1, "maxLength": 256},
        "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "key_lifecycle_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle_event_count",
        "boundary_count",
        "invalidated_signature_count",
        "quorum_group_count",
        "cutoff_registry_sequence",
        "final_head_hash",
        "external_completeness_proven"
      ],
      "properties": {
        "lifecycle_event_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "boundary_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "invalidated_signature_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "quorum_group_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "cutoff_registry_sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "final_head_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "external_completeness_proven": {"const": false}
      }
    },
    "physical_interpretation": {"const": "NO_AUTOMATIC_PHYSICAL_RETROCAUSALITY_CLAIM"},
    "fail_open": {"const": false}
  },
  "description": "crypto_backend is optional for historical verifier results. key_lifecycle_summary is optional for pre-v0.7 results and records only local lifecycle-chain replay; its external_completeness_proven field is deliberately false until a later external freshness/transparency gate independently establishes the accepted lifecycle head."
}
