{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/witness-registry.schema.json",
  "title": "AIFC Witness Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registry_id", "experiment_id", "registry_sequence", "previous_registry_hash", "fault_model", "witnesses"],
  "properties": {
    "schema": {"const": "AIFC/witness-registry/v1"},
    "registry_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "registry_sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "previous_registry_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "transition_certificate_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "fault_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "f", "q", "independence_unit"],
      "properties": {
        "n": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "f": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "q": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "independence_unit": {"const": "FAILURE_DOMAIN"}
      }
    },
    "witnesses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["witness_id", "failure_domain", "status", "keys"],
        "properties": {
          "witness_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
          "failure_domain": {"type": "string", "minLength": 1, "maxLength": 256},
          "status": {"enum": ["ACTIVE", "OFFLINE", "REVOKED", "COMPROMISED", "RETIRED"]},
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key_id", "algorithm", "public_key_encoding", "public_key", "valid_from_registry_sequence", "status"],
              "properties": {
                "key_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
                "algorithm": {"const": "Ed25519"},
                "public_key_encoding": {"const": "hex"},
                "public_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "valid_from_registry_sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                "valid_until_registry_sequence": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
                "status": {"enum": ["ACTIVE", "REVOKED", "COMPROMISED", "RETIRED"]},
                "predecessor_key_id": {"type": ["string", "null"]},
                "revocation_reason": {"type": ["string", "null"], "maxLength": 512}
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"registry_sequence": {"const": 0}}, "required": ["registry_sequence"]},
      "then": {"properties": {"transition_certificate_hash": {"type": "null"}}},
      "else": {"required": ["transition_certificate_hash"], "properties": {"transition_certificate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
    }
  ],
  "description": "Strongest-grade AIFC v1 uses one canonical Ed25519 public-key representation: exactly 32 key bytes encoded as 64 lowercase hexadecimal characters. For registry_sequence=0, previous_registry_hash must equal the frozen registry-genesis sentinel. Full verifier must enforce unique witness_id, safe 2q>n+f, registry n against admitted membership, at least q distinct failure domains, signature verification, and historical key-lifecycle semantics."
}
