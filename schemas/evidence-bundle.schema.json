{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/AIFC/schemas/evidence-bundle.schema.json",
  "title": "AIFC Evidence Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "experiment_id",
    "trial_index",
    "run_id",
    "experiment_plan_hash",
    "trial_ledger_head_hash",
    "pre_return_certificate_hash",
    "candidate_generation_profile_hash",
    "candidate_set_hash",
    "candidate_multiplicity",
    "target_selector_profile_hash",
    "target_derivation_profile_hash",
    "conditioning_view_hash",
    "entropy_profile_hash",
    "causal_model_hash",
    "statistical_plan_hash",
    "witness_registry_hash",
    "witness_registry_transition_hash",
    "target_evidence_hash"
  ],
  "properties": {
    "schema": {"const": "AIFC/evidence-bundle/v1"},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "trial_index": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "experiment_plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trial_ledger_head_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pre_return_certificate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_generation_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_multiplicity": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "target_selector_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_derivation_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "conditioning_view_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entropy_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "causal_model_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "statistical_plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "witness_registry_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "witness_registry_transition_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "target_evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "eprocess_state_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "additional_evidence_hashes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "uniqueItems": true
    }
  },
  "description": "Per-trial bundle binds evidence available through VERIFIED. The subsequent TERMINAL event binds the bundle hash. The experiment-level publication manifest is created only after trial termination and references bundle/terminal hashes; it is intentionally NOT referenced from the bundle, avoiding a publication fixed-point."
}
