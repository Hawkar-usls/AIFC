{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/Hawkar-usls/AIFC/schemas/semantic-bridge-execution-profile-v2.schema.json","title":"AIFC Semantic Bridge Execution Profile v2","type":"object","additionalProperties":false,"required":["schema","execution_profile_id","predecessor_execution_profile_id","predecessor_execution_profile_git_blob_sha1","entailment_question_id","semantic_bridge_theory_id","semantic_bridge_theory_content_hash","endpoint_identity_profile_id","endpoint_identity_profile_content_hash","entailment_method_profile_id","entailment_method_profile_content_hash","composition_rule","bridge_axiom_schema_id","formula_ast_schema_id","execution_implementation_path","execution_implementation_git_blob_sha1","execution_implementation_raw_sha256","execution_authority_status","authority_lineage_status","profile_content_hash"],"properties":{"schema":{"const":"AIFC/semantic-bridge-execution-profile/v2"},"execution_profile_id":{"type":"string","minLength":1},"predecessor_execution_profile_id":{"const":"AIFC-SAL-V1.9-SEMANTIC-BRIDGE-EXECUTION-PROFILE-V1"},"predecessor_execution_profile_git_blob_sha1":{"type":"string","pattern":"^[0-9a-f]{40}$"},"entailment_question_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"semantic_bridge_theory_id":{"type":"string","minLength":1},"semantic_bridge_theory_content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"endpoint_identity_profile_id":{"type":"string","minLength":1},"endpoint_identity_profile_content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"entailment_method_profile_id":{"type":"string","minLength":1},"entailment_method_profile_content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"composition_rule":{"const":"PREMISE_AND_ORDERED_ENDPOINT_CLOSED_BRIDGE_AXIOMS_V1"},"bridge_axiom_schema_id":{"const":"AIFC/semantic-bridge-axiom/v2"},"formula_ast_schema_id":{"const":"AIFC/semantic-formula/v1"},"execution_implementation_path":{"type":"string","minLength":1},"execution_implementation_git_blob_sha1":{"type":"string","pattern":"^[0-9a-f]{40}$"},"execution_implementation_raw_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"execution_authority_status":{"enum":["SUCCESSOR_CANDIDATE_NOT_AUTHORITY_ADMISSIBLE","AUTHORITY_ADMISSIBLE"]},"authority_lineage_status":{"enum":["NOT_ESTABLISHED","AUTHORITY_LINEAGE_ESTABLISHED"]},"profile_content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"description":"Successor execution profile binding the endpoint-identity-closed bridge composition implementation. It remains non-authoritative until lineage replay."}
